# Copy to .env and adjust. Without changes the app runs in demo mode: everything is read from data/,
# e-mails are written to data/outbox/ (nothing is sent), no credentials needed.

BASE_URL=http://localhost:8000          # public address of this app – used in the approve/reject links of the review e-mail
PORT=8000
AGENTS=aris,zero                        # which agents process each new application
BASIC_AUTH_USER=                        # portal login – set both when the app is reachable from the internet
BASIC_AUTH_PASSWORD=

# ---- where the agents read from: local (demo files in data/) or live
ARIS_SOURCE=local                       # live = ARIS MCP (documents, SOPs + amendments, process data)
DRIVE_SOURCE=local                      # live = Google Drive / Docs / Sheets (agent without context)

# ---- intake: new applications by e-mail (Gmail). Uploading a PDF in the portal always works.
GMAIL_INTAKE=false
GMAIL_QUERY=is:unread has:attachment filename:pdf -label:zerogap-processed
POLL_SECONDS=60

# ---- outgoing e-mail: outbox (store .eml only) | gmail | smtp
MAIL_MODE=outbox
REVIEW_EMAIL_TO=caseworker@your-domain.example
CASE_MANAGER_EMAIL=case.manager@your-domain.example
TEST_RECIPIENT=                         # while testing: every letter to an applicant goes here instead
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Google (live Drive and/or Gmail). Create an OAuth "Desktop app" client in Google Cloud, save it as
#      secrets/google_client.json, then run: python app.py google-login
DRIVE_FOLDER_ID=1iMfa7Sa0iMr7_azGRBhxd7Riavy6weLV
EVENT_LOG_NAME=Bitmarck_Care_Application_obj     # the event-log CSV / Google Sheet in that folder (name without .csv)
EVENT_LOG_ROWS=18229

# ---- ARIS MCP (live). Either a bearer token, or run: python app.py aris-login (browser sign-in, stored in secrets/)
ARIS_MCP_URL=https://myfirst.ariscloud.com/aris-mcp/mcp
ARIS_MCP_TOKEN=
ARIS_TOOL_SEARCH=aris_ads_document_search
ARIS_TOOL_GET_TEXT=aris_ads_document_getAsText
ARIS_GET_TEXT_ARG=guid
ARIS_TOOL_QUERY=aris_miningserver_query

# ---- LLM (optional). Without a key the rule-checked template letter is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- rules
CHECK_DATE=auto                         # or a fixed date like 2026-10-08 for repeatable demos
STEP_DELAY_MS=0                         # demo only: e.g. 600 to watch the steps progress live in the portal
